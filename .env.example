# ====================================================
# Configuración Global de Microservicios (Docker Compose)
# ====================================================

# Base de Datos PostgreSQL Principal
POSTGRES_USER=clicker
POSTGRES_PASSWORD=clicker
POSTGRES_PORT=5432
DB_SSL_REQUIRE=0

# Clave compartida para firma y verificación de JWT entre microservicios
JWT_SIGNING_KEY=shared-jwt-signing-key-for-microservices-123456

# Clave secreta interna para comunicación entre servicios (ej: shop -> game)
INTERNAL_API_SECRET=internal-shared-secret-key-123456

# Modo de desarrollo (1) o producción (0)
DJANGO_DEBUG=1

# Secret keys individuales para cada microservicio
IDENTITY_SECRET_KEY=identity-secret-key-for-dev-123456
GAME_SECRET_KEY=game-secret-key-for-dev-123456
SHOP_SECRET_KEY=shop-secret-key-for-dev-123456
LEADERBOARD_SECRET_KEY=leaderboard-secret-key-for-dev-123456

# Puertos
GATEWAY_PORT=8000
FRONTEND_PORT=3000

# URL pública de la API consumida por el navegador del cliente
NUXT_PUBLIC_API_BASE=http://localhost:8000/api/v1
