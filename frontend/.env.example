# ==========================================
# Configuración del Frontend (Nuxt 4)
# ==========================================

# URL base accesible desde el navegador para llamar a la API
# Local / Docker: http://localhost:8000/api/v1
# Producción: https://api.tudominio.com/api/v1
NUXT_PUBLIC_API_BASE=http://localhost:8000/api/v1

# Puerto y host del servidor Nuxt (por defecto 3000 y 0.0.0.0 en Docker)
PORT=3000
HOST=0.0.0.0
